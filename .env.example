# AutoGTM — environment template. Copy to .env and fill in what you use.

# --- Required -----------------------------------------------------------------
# SQLite database file (Prisma). Relative paths resolve from the project root.
DATABASE_URL=file:./db/custom.db

# Public base URL of the app — used to build unsubscribe links, open-pixel and
# tracked-CTA URLs embedded in real emails. Falls back to localhost:3000.
APP_URL=http://localhost:3000

# --- Email delivery (optional — without these the app runs in demo mode) ------
# Give EITHER a Resend key OR SMTP credentials; Resend wins when both are set.
# Every first touch is then delivered for real, metering and autopilot keep
# working exactly the same, and bounce/complaint webhooks suppress the lead.
RESEND_API_KEY=
# Verified sender identity on your Resend account, e.g. "Riley <riley@yourbrand.io>"
RESEND_FROM=
# Svix signing secret from the Resend dashboard webhook settings
# (verifies POST /api/webhooks/resend signatures, 5-minute replay window)
RESEND_WEBHOOK_SECRET=

# Generic SMTP fallback (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Tuning (optional) ---------------------------------------------------------
# Scheduled report digest interval in ms. The demo compresses a "week" to 2
# minutes; set 604800000 for a real week.
REPORT_INTERVAL_MS=120000
